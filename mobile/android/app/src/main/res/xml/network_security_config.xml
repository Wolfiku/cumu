<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow cleartext (HTTP) traffic to any host — needed for local self-hosted server -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
