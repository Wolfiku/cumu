<?xml version="1.0" encoding="utf-8"?>
<!-- cumu runs on home servers and NAS, usually reached via plain HTTP on the
     local network (http://192.168.x.x:3000), so cleartext traffic is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
