# cumu configuration - copy to .env
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=change-this-to-a-random-secret
# Required for every admin login. Generated automatically on first start if empty.
ADMIN_LOGIN_CODE=
# Behind a reverse proxy: true, a hop count (1) or a subnet, so failed logins
# are counted per real client IP. Leave empty without a proxy.
TRUST_PROXY=
MUSIC_PATH=./music
MAX_STORAGE_GB=50
DB_PATH=./data/cumu.db
SETUP_DONE=false
